HOST=0.0.0.0
PORT=8000
DEBUG=true

# mock | raspberry
HARDWARE_MODE=mock

# simulation | usb | file | network
CAMERA_MODE=simulation

# development | simulation | raspberry
RUN_MODE=simulation

INTERSECTION_CONFIG_PATH=config/intersection.json
YOLO_MODEL_PATH=models/yolov8n.pt
VIDEO_SOURCE=0

SIMULATION_SPEED=1.0
SIMULATION_SPAWN_RATE=0.3

DEFAULT_GREEN_DURATION=30
DEFAULT_YELLOW_DURATION=3
DEFAULT_RED_DURATION=30

PEDESTRIAN_PRIORITY_THRESHOLD=5
PEDESTRIAN_PRIORITY_WEIGHT=1.3

YOLO_CONFIDENCE=0.5
YOLO_DEVICE=cpu

CAMERA_FPS=10
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
